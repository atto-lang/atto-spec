{
  "schema": "atto.specification-rules.v1",
  "schema_version": 1,
  "authority": {
    "repository": "atto-lang/atto-spec",
    "branch": "main",
    "document": "language/specification-framework-v1.md",
    "publication": "proposed framework; source documents retain their stated status"
  },
  "evidence_taxonomy": [
    "source_only",
    "host_model",
    "compiler_parse",
    "compiler_typecheck",
    "compiled_guest",
    "native_aot",
    "formal_model"
  ],
  "result_statuses": [
    "passed",
    "failed",
    "unsupported",
    "not_executed"
  ],
  "backend_targets": [
    "rs",
    "llvm",
    "wasm",
    "cranelift",
    "java",
    "net",
    "forge",
    "atto"
  ],
  "default_backend_status": "not_executed",
  "formatter_targets": [
    "atto-lang/atto-format",
    "ores-truffle-oreslang/oreslang-format"
  ],
  "rules": [
    {
      "id": "ATTO-SPEC-001",
      "layer": "governance",
      "title": "Single normative authority and edition-scoped rule identity",
      "source": "language/specification-framework-v1.md",
      "status": "proposed_process",
      "formatter": "must_follow",
      "conformance": null,
      "proof": "traceable_rule_authority"
    },
    {
      "id": "ATTO-SYN-001",
      "layer": "syntax",
      "title": "Zero or one file namespace header, before every import or declaration",
      "source": "language/unified-static-imports-v1.md",
      "status": "target",
      "formatter": "preserve_invalidity",
      "conformance": null,
      "proof": "namespace_parse_and_scope_invariance"
    },
    {
      "id": "ATTO-SYN-002",
      "layer": "syntax",
      "title": "Static import selectors and source/package distinction",
      "source": "language/unified-static-imports-v1.md",
      "status": "target",
      "formatter": "contextual_only",
      "conformance": null,
      "proof": "static_binding_resolution"
    },
    {
      "id": "ATTO-TYPE-001",
      "layer": "static_semantics",
      "title": "Explicit named callable return annotation",
      "source": "language/explicit-callable-return-types-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": null,
      "proof": "return_type_preservation"
    },
    {
      "id": "ATTO-OWN-001",
      "layer": "static_semantics",
      "title": "Default scoped readonly borrow for nonprimitive call arguments",
      "source": "language/implicit-argument-borrow-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": {
        "repo": "atto-lang/atto-platform-conformance",
        "path": "contracts/ownership-vocabulary-v1.json"
      },
      "proof": "loan_exclusivity_and_outlives"
    },
    {
      "id": "ATTO-OWN-002",
      "layer": "static_semantics",
      "title": "take! invalidates source owner; drop! is consuming",
      "source": "language/ownership-vocabulary-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": {
        "repo": "atto-lang/atto-platform-conformance",
        "path": "contracts/ownership-vocabulary-v1.json"
      },
      "proof": "no_use_after_move_or_double_drop"
    },
    {
      "id": "ATTO-OWN-003",
      "layer": "static_semantics",
      "title": "copy!! deep graph copy is distinct from copy! shallow/value copy",
      "source": "language/ownership-vocabulary-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": {
        "repo": "atto-lang/atto-platform-conformance",
        "path": "contracts/ownership-vocabulary-v1.json"
      },
      "proof": "clone_independence_and_alias_topology"
    },
    {
      "id": "ATTO-CONST-001",
      "layer": "dynamic_semantics",
      "title": "Top-level const constexpr or once-per-instance permitted environment snapshot",
      "source": "language/file-module-const-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": {
        "repo": "atto-lang/atto-platform-conformance",
        "path": "contracts/file-module-const-v1.json"
      },
      "proof": "startup_snapshot_noninterference"
    },
    {
      "id": "ATTO-RUN-001",
      "layer": "dynamic_semantics",
      "title": "trap preserves Result/Option wrapping and converts ordinary throw only",
      "source": "language/trap-result-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": null,
      "proof": "exception_result_refinement"
    },
    {
      "id": "ATTO-ACTOR-001",
      "layer": "concurrency",
      "title": "Actor physical incarnation fenced from logical virtual identity",
      "source": "language/actor-registry-v1.md",
      "status": "target",
      "formatter": "must_preserve",
      "conformance": {
        "repo": "atto-lang/atto-platform-conformance",
        "path": "contracts/actor-registry-v1.json"
      },
      "proof": "actor_identity_and_linearization"
    },
    {
      "id": "ATTO-FMT-001",
      "layer": "formatting",
      "title": "Formatting is idempotent within the same edition and source context",
      "source": "language/specification-framework-v1.md",
      "status": "proposed_process",
      "formatter": "invariant",
      "conformance": null,
      "proof": "formatter_fixed_point"
    },
    {
      "id": "ATTO-FMT-002",
      "layer": "formatting",
      "title": "Formatting preserves static validity and semantic AST or rejects safely",
      "source": "language/specification-framework-v1.md",
      "status": "proposed_process",
      "formatter": "invariant",
      "conformance": null,
      "proof": "parse_semantic_refinement"
    },
    {
      "id": "ATTO-FMT-003",
      "layer": "formatting",
      "title": "Formatting must not repair malformed or statically forbidden source",
      "source": "language/specification-framework-v1.md",
      "status": "proposed_process",
      "formatter": "preserve_invalidity",
      "conformance": null,
      "proof": "negative_admission_preservation"
    },
    {
      "id": "ATTO-FORMAL-001",
      "layer": "formal",
      "title": "Model results are not implementation or multi-backend execution proof",
      "source": "formal/specification-refinement-obligations-v1.md",
      "status": "proposed_process",
      "formatter": "not_applicable",
      "conformance": null,
      "proof": "evidence_scope_separation"
    },
    {
      "id": "ATTO-GOV-001",
      "layer": "governance",
      "title": "Every normative change needs traceable compatibility and evidence disposition",
      "source": "language/specification-framework-v1.md",
      "status": "proposed_process",
      "formatter": "must_follow",
      "conformance": null,
      "proof": "change_control_traceability"
    }
  ],
  "formatter_cases": [
    {
      "id": "fmt-namespace-before-import",
      "rule_ids": [
        "ATTO-SYN-001",
        "ATTO-FMT-002"
      ],
      "input": "use namespace storefront;\nimport * as math from \"./math.atto\";\npub fnc main(): int { return 0; }\n",
      "required": "preserve_semantics",
      "context": {
        "logical_path": "src/storefront/main.atto"
      }
    },
    {
      "id": "fmt-namespace-invalid-order",
      "rule_ids": [
        "ATTO-SYN-001",
        "ATTO-FMT-003"
      ],
      "input": "import * as math from \"./math.atto\";\nuse namespace storefront;\n",
      "required": "reject_or_remain_invalid",
      "context": {
        "logical_path": "src/storefront/main.atto"
      }
    },
    {
      "id": "fmt-namespace-duplicate",
      "rule_ids": [
        "ATTO-SYN-001",
        "ATTO-FMT-003"
      ],
      "input": "use namespace storefront;\nuse namespace storefront;\n",
      "required": "reject_or_remain_invalid",
      "context": {
        "logical_path": "src/storefront/main.atto"
      }
    },
    {
      "id": "fmt-deep-copy-distinction",
      "rule_ids": [
        "ATTO-OWN-003",
        "ATTO-FMT-002"
      ],
      "input": "val x = copy! original;\nval y = copy!! original;\n",
      "required": "preserve_semantics"
    },
    {
      "id": "fmt-ownership-transfer",
      "rule_ids": [
        "ATTO-OWN-002",
        "ATTO-FMT-002"
      ],
      "input": "val next = take! owner;\ndrop! next;\n",
      "required": "preserve_semantics"
    },
    {
      "id": "fmt-static-env-const",
      "rule_ids": [
        "ATTO-CONST-001",
        "ATTO-FMT-002"
      ],
      "input": "define const string api_host as os.read_env(\"API_HOST\");\n",
      "required": "preserve_semantics"
    },
    {
      "id": "fmt-explicit-return",
      "rule_ids": [
        "ATTO-TYPE-001",
        "ATTO-FMT-002"
      ],
      "input": "pub fnc main(): int { return 42; }\n",
      "required": "preserve_semantics"
    },
    {
      "id": "fmt-lifetime-context",
      "rule_ids": [
        "ATTO-OWN-001",
        "ATTO-FMT-002"
      ],
      "input": "fnc inspect<lifetime! a, T>(Borrow<T, lt=a> value) -> void {}\n",
      "required": "contextual_equivalence_only"
    }
  ]
}
