{
  "schema": "attolang-atomic-receive-v1",
  "status": "TARGET",
  "version": 1,
  "decision_date": "2026-11-14",
  "standard_library": {
    "type": "Atomic<T>",
    "default_order": "seq_cst",
    "supported_scalar_target": [
      "bool",
      "int",
      "i8",
      "i16",
      "i32",
      "i64",
      "u8",
      "u16",
      "u32",
      "u64"
    ],
    "unsupported": [
      "String",
      "Pointer<T>",
      "aggregate"
    ],
    "checked_integer_rmw": true
  },
  "memory_orders": {
    "load": [
      "relaxed",
      "acquire",
      "seq_cst"
    ],
    "store": [
      "relaxed",
      "release",
      "seq_cst"
    ],
    "rmw": [
      "relaxed",
      "acquire",
      "release",
      "acq_rel",
      "seq_cst"
    ],
    "cas_failure": [
      "relaxed",
      "acquire",
      "seq_cst"
    ]
  },
  "scheduling": {
    "default_actor_receive": "concurrent_bounded",
    "default_actor_methods": "concurrent_bounded",
    "serial_actor_receive": "one_live_invocation_including_suspension",
    "serial_actor_other_methods": "concurrent_not_gated_by_receive",
    "state": "compiler_verified_critical_readers_exclusive_writer",
    "stack": "one_stack_per_independent_invocation"
  },
