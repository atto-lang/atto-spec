{
  "schema_version": 1,
  "status": "LEXICAL_TARGET_ONLY_NOT_BACKEND_EXECUTED",
  "rule": "E_BANG_KEYWORD_WHITESPACE",
  "scope": "code-position contextual keyword prefix; separator admission is not semantic acceptance",
  "keywords": [
    "trap!",
    "throw!",
    "raise!",
    "panic!",
    "copy!",
    "copy!!",
    "take!",
    "borrow!",
    "share!",
    "pin!",
    "drop!",
    "pipe!",
    "rpipe!",
    "stop!",
    "expand!"
  ],
  "backends": [
    "atto",
    "cranelift",
    "forge",
    "hdl",
    "java",
    "js",
    "llvm",
    "net",
    "realtime",
    "rs",
    "wasm"
  ],
