  "schema_version": 1,
  "contract_id": "atto-explicit-initialization-v1",
  "status": "PROPOSED_NOT_VERIFIED",
  "spec_chapter": "28",
  "source_extension": ".atto",
  "required_backends": [
    "java",
    "llvm",
    "wasm",
    "dotnet",
    "forge",
    "cranelift"
  ],
  "evidence_policy": {
    "baseline": "NOT_EXECUTED",
    "positive_cases_require": "REAL_GUEST_COMPILE_AND_EXECUTE",
    "negative_cases_require": "TARGETED_SEMANTIC_DIAGNOSTIC_AND_NO_ARTIFACT",
    "reject_evidence": [
      "source_only_contract_test",
      "host_only_model",
      "generic_parser_error",
      "simulated_guest_result",
      "zero_step_ci",
      "unverified_cross_org_mirror"
    ]
  },
  "rules": {
    "implicit_zero_value": "reject",
    "implicit_null_or_none": "reject",
    "local_without_initializer": "reject_even_if_assigned_later",
    "field_initialization": "explicit_field_initializer_or_proven_exactly_once_constructor_assignment",
    "aggregate_missing_field": "reject_unless_declaration_has_explicit_default_initializer",
    "collection_elements": "initialize_all_elements_before_exposure",
    "implicit_default_constructor_or_trait": "never_synthesize_or_invoke_implicitly",
    "explicit_default_factory_call": "allowed_only_if_it_returns_fully_initialized_value",
    "binding_modifiers": "do_not_supply_values",
    "backend_uninitialized_storage": "unobservable_until_fully_initialized"
  },
