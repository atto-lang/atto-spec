{
  "schema": "atto.readonly-shape-projection/v1",
  "version": 1,
  "status": "HOST_WITNESS_CONTRACT_NOT_GUEST_ABI",
  "description": "Bounded, statically verified read-only i64 class/record/struct field plan. No dynamic map, actor, nullable, union, singleton, owned transfer or async escape is authorized.",
  "max_fields": 32,
  "requirements": {
    "actual_source_offset": true,
    "source_identity": true,
    "positive_layout_epoch": true,
    "positive_loan_id": true,
    "only_public_immutable_i64": true,
    "reject_overlapping_offsets": true,
    "no_pointer_reinterpretation": true,
    "no_map_or_actor_scope": true
  },
  "example": {
    "formals": "fnc read_x(p: {x: int}): int { return p.x; }",
    "class_a": {
      "name": "A",
      "fields": [
        {
          "name": "x",
          "slot": 0,
          "value": 42
        }
      ]
    },
    "class_b": {
      "name": "B",
      "fields": [
        {
          "name": "padding",
          "slot": 0,
          "value": 10
        },
        {
          "name": "x",
          "slot": 1,
          "value": 42
        }
      ]
    },
    "expected_result": 84,
    "execution_status": "TARGET_GUEST_NOT_EXECUTED"
  },
