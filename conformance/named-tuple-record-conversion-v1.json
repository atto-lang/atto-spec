      "field": {
        "x": {
          "type": "int",
          "value": 1
        }
      }
    },
    {
      "id": "first-equals",
      "source": "let Tuple t = Tuple.of(x := 1, x := \"two\"); let Record r = t.to_record(duplicates=#first);",
      "expect": "accept",
      "field": {
        "x": {
          "type": "int",
          "value": 1
        }
      }
    },
    {
      "id": "last-colon",
      "source": "let Tuple t = Tuple.of(x := 1, x := \"two\"); let Record r = t.to_record(duplicates: #last);",
      "expect": "accept",
      "field": {
        "x": {
          "type": "string",
          "value": "two"
        }
      }
    },
    {
      "id": "last-equals",
      "source": "let Tuple t = Tuple.of(x := 1, x := \"two\"); let Record r = t.to_record(duplicates=#last);",
      "expect": "accept",
      "field": {
        "x": {
          "type": "string",
          "value": "two"
        }
      }
    },
    {
      "id": "pair-not-policy",
