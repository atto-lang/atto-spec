  "sourceCases": [
    {
      "id": "tuple-named",
      "source": "let Tuple t = Tuple.of(five := 5, three := \"box\");",
      "expect": "accept"
    },
    {
      "id": "record-named",
      "source": "let Record r = Record.of(five := 5, three := \"box\");",
      "expect": "accept"
    },
    {
      "id": "tuple-repeat",
      "source": "let Tuple t = Tuple.of(x := 1, x := \"two\");",
      "expect": "accept"
    },
    {
      "id": "record-repeat",
      "source": "let Record r = Record.of(x := 1, x := \"two\");",
      "expect": "reject-duplicate-field"
    },
    {
      "id": "strict",
      "source": "let Tuple t = Tuple.of(five := 5, three := \"box\"); let Record r = t.to_record();",
      "expect": "accept"
    },
    {
      "id": "strict-repeat",
      "source": "let Tuple t = Tuple.of(x := 1, x := 2); let Record r = t.to_record();",
      "expect": "reject-duplicate-field"
    },
    {
      "id": "first-colon",
      "source": "let Tuple t = Tuple.of(x := 1, x := \"two\"); let Record r = t.to_record(duplicates: #first);",
