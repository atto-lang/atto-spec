      "expected": "reject",
      "status": "not_executed"
    },
    {
      "id": "expected_actual_same_type",
      "snippet": "assert.equal(1, \"1\");",
      "phase": "typecheck",
      "expected": "reject",
      "status": "not_executed"
    },
    {
      "id": "bare_call_not_stdlib",
      "snippet": "assert(true);",
