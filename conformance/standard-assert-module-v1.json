    },
    {
      "id": "not_equal_i64",
      "snippet": "assert.not_equal(42, 43);",
      "phase": "runtime",
      "expected": "pass",
      "status": "not_executed"
    },
    {
      "id": "true_fail",
      "snippet": "assert.true(false);",
      "phase": "runtime",
      "expected": "AssertionError",
      "status": "not_executed"
    },
    {
      "id": "false_fail",
      "snippet": "assert.false(true);",
      "phase": "runtime",
      "expected": "AssertionError",
      "status": "not_executed"
    },
    {
      "id": "equal_fail",
      "snippet": "assert.equal(42, 43);",
      "phase": "runtime",
      "expected": "AssertionError",
      "status": "not_executed"
    },
    {
      "id": "not_equal_fail",
      "snippet": "assert.not_equal(42, 42);",
      "phase": "runtime",
      "expected": "AssertionError",
      "status": "not_executed"
    },
    {
