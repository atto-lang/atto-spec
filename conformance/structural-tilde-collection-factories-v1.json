    {
      "id": "factory-smoke-return-21",
      "expected": "ACCEPT",
      "phase": "guest",
      "source": "pub fnc main(): int { val pair = Tuple.of(10,20); val values = Array.of(1,2,3); val names = List.of(\"Atto\",\"Lima\"); val scores = Map.of(\"a\",10,\"b\",20); val item = Record.of(name=\"Atto\",count=3); return values[0] + pair[1]; }",
      "expected_exit": 21
    },
    {
      "id": "record-of-named-infer",
      "expected": "ACCEPT",
      "phase": "type",
      "source": "val item = Record.of(name=\"Atto\", count=3);"
    },
    {
      "id": "record-of-static-quoted",
      "expected": "ACCEPT",
      "phase": "type",
      "source": "val headers = Record.of(\"content-type\": \"text/plain\", status=200);"
    },
    {
      "id": "record-of-empty",
      "expected": "ACCEPT",
      "phase": "type",
      "source": "val empty = Record.of();"
    },
    {
      "id": "record-of-explicit-shape",
      "expected": "ACCEPT",
      "phase": "type",
      "source": "val Record<{name: string, count: int}> item = Record.of(name=\"Atto\", count=3);"
    },
    {
      "id": "record-of-type-parameter",
      "expected": "ACCEPT",
      "phase": "type",
