      "source": "val Array<int> x = Array.of();"
    },
    {
      "id": "tuple-of-zero",
      "expected": "ACCEPT",
      "phase": "type",
      "source": "val x = Tuple.of();"
    },
    {
      "id": "record-of-duplicate-fields",
      "expected": "REJECT",
      "phase": "type",
      "source": "val r = Record.of(name=1, \"name\": 2);",
      "code": "E_DUPLICATE"
    },
    {
      "id": "record-of-computed-key",
      "expected": "REJECT",
      "phase": "type",
      "source": "val key = \"name\"; val r = Record.of(key => 1);",
      "code": "E_UNSUPPORTED"
    },
    {
      "id": "record-of-shape-mismatch",
      "expected": "REJECT",
      "phase": "type",
      "source": "val Record<{name: string}> r = Record.of(name=3);",
      "code": "E_TYPE"
    },
    {
      "id": "record-of-missing-generic-field",
