  "guest_required": true,
  "description": "Nominal immutable Entry fat-arrow syntax and mutable Map upsert/presence behavior. No backend guest evidence is implied.",
  "vectors": [
    {
      "id": "entry-literal-basic",
      "kind": "positive",
      "source": "let Entry<string,int> e = \"foo\" => 5;",
      "expect": "nominal Entry<string,int>"
    },
    {
      "id": "entry-infer",
      "kind": "positive",
      "source": "let e = \"foo\" => 5;",
      "expect": "nominal Entry<string,int>"
    },
    {
      "id": "entry-factory-equivalent",
      "kind": "positive",
      "source": "let Entry<string,int> e = Entry.of(\"foo\", 5);",
      "expect": "equivalent key/value and nominal type"
    },
    {
      "id": "map-nested-entry",
      "kind": "positive",
      "source": "let Map<string,Entry<string,int>> m = {\"key\" => (\"foo\" => 5)};",
      "expect": "Map item delimiter distinct from parenthesized Entry"
    },
    {
      "id": "map-mutation-sequence",
      "kind": "positive",
      "fixture": "conformance/entry-map-upsert-v1.atto",
      "expect": "guest main exit code 5"
    },
    {
      "id": "try-add-existing",
      "kind": "positive",
      "source": "let mut Map<string,int> m = {\"foo\" => 5}; let bool inserted = m.try_add(\"foo\" => 7); assert.false(inserted); assert.equal(m.get(\"foo\").unwrap(), 5);",
      "expect": "duplicate false and unchanged value"
    },
    {
