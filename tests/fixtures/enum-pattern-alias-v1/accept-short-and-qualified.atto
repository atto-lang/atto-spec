use namespace jobs;

define enum WorkerMsg {
    Run { job_id: u64, payload: Bytes },
    Stop
}

define enum ServerMsg {
    Stop
}

declare actor Worker;

mtd (Worker self) receive(msg: WorkerMsg): void {
    do match msg over
        on Run as r -> {
            val job_id = r.job_id;
        }
        on WorkerMsg.Stop -> {}
    end
}
